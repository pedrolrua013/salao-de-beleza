# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Só no servidor. Usada apenas para convidar a equipe. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico

# Endereço público do sistema (link de agendamento e aviso de pagamento do Mercado Pago).
NEXT_PUBLIC_SITE_URL=https://app.seudominio.com.br
# Cabeçalho com o IP real de quem acessa (limites de tentativa e prova de aceite). Na Vercel deixe vazio; atrás do Cloudflare é OBRIGATÓRIO usar cf-connecting-ip.
# IP_CABECALHO=

# WhatsApp (Meta). Só no servidor.
# App secret: developers.facebook.com > seu app > Configurações > Básico. Usado para conferir a assinatura do webhook.
META_APP_SECRET=segredo-do-app-da-meta
# Texto que você inventa e cola no cadastro do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=um-texto-longo-e-aleatorio
# Opcional. Versão da API do Graph.
WHATSAPP_API_VERSION=v23.0

# Lembretes de consulta. Segredo que protege /api/cron/lembretes (o agendador externo o envia como Bearer; veja DEPLOY.md).
# Gere um com: openssl rand -hex 32
CRON_SECRET=um-texto-longo-e-aleatorio

# Só para testar o robô sem conta na Meta (veja docs/TESTE-WHATSAPP.md). Nada sai para a internet; as respostas aparecem em Conversas.
# Ignorado em produção (NODE_ENV=production), mesmo que esteja definido.
# WHATSAPP_SIMULAR=1

# Só para testar a nota fiscal sem emissor: a nota é "autorizada" na hora e nada vai para a prefeitura. Ignorado em produção.
# NFSE_SIMULAR=1

# IA no WhatsApp (opcional): chave da API do Claude. Sem ela, o robô segue só com o menu.
# ANTHROPIC_API_KEY=
